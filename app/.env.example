# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under: Supabase dashboard -> Project Settings -> API
#
# The frontend uses Supabase for AUTHENTICATION ONLY. All application data goes
# through the Node API (see the `server/` service). The anon key is safe to
# expose in the browser; the powerful service-role key lives only on the server.

VITE_SUPABASE_URL=https://urmqmsruqmwpmmnusvqc.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Base URL of the Node API. Leave as '/api' for local dev (the Vite dev server
# proxies it to the Node service). In production set this to the deployed API
# origin, e.g. https://api.example.com/api
VITE_API_URL=/api
