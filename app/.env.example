# Copy to .env.local for local dev. These values are PUBLIC (baked into the
# browser build): the anon/publishable key is safe to expose; the service-role
# key is NOT and lives only in server/.env.
# Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Base URL of the Node API. '/api' works in dev (Vite proxy) and in the
# single-origin production image (the server serves the built app). Use a full
# origin only if the API is hosted separately, e.g. https://api.example.com/api
VITE_API_URL=/api
