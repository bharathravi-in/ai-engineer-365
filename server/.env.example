# Copy this file to .env and fill in the values.
# These live ONLY on the server — never expose the service-role key to the browser.

# Supabase project URL (same value as the app's VITE_SUPABASE_URL).
SUPABASE_URL=https://your-project.supabase.co

# Service-role key: Supabase dashboard -> Project Settings -> API -> service_role.
# This key BYPASSES Row Level Security, so it must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port the API listens on (the Vite dev proxy expects 8787).
PORT=8787

# Comma-separated list of allowed browser origins for CORS.
# Dev default is the Vite dev server. Add your deployed frontend origin in prod.
CORS_ORIGIN=http://localhost:5173
