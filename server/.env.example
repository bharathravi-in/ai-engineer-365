# Copy to .env. These live ONLY on the server — never expose the service-role
# key (or these values) to the browser.

# Supabase project URL (same value as the app's VITE_SUPABASE_URL).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Service-role / secret key: Supabase dashboard → Project Settings → API.
# BYPASSES Row Level Security, so it must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Port the API listens on (the Vite dev proxy expects 8787).
PORT=8787

# Comma-separated allowed browser origins for CORS (prod frontend origin(s)).
# Not needed when the server serves the SPA on the same origin.
CORS_ORIGIN=http://localhost:5173

# --- Production options -------------------------------------------------------
# NODE_ENV=production
# Serve the built frontend from the API (single origin). Auto-on when app/dist
# exists; point STATIC_DIR at it if it's elsewhere. Set SERVE_STATIC=false to disable.
# STATIC_DIR=../app/dist
# Proxy hops to trust for client IPs / rate limiting (1 behind one LB/CDN).
# TRUST_PROXY=1
# Rate limits (defaults: 600 req / 15 min on /api, 120 on admin writes).
# RATE_LIMIT_MAX=600
# WRITE_RATE_LIMIT_MAX=120
