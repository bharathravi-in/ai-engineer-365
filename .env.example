# Root env for `docker compose` — copy to .env and fill in. DO NOT COMMIT .env.
# These come from your Supabase project: Settings → API and Settings → Database.

# --- Public (safe to expose in the browser; baked into the frontend build) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Server-only secrets (NEVER shipped to the browser) ----------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# --- Deployment ---------------------------------------------------------------
# Public origin the app is served from (used for CORS; same-origin needs no CORS).
CORS_ORIGIN=https://skillmap.example.com
PORT=8787
# Number of proxy hops to trust for client IPs (1 behind a single LB/CDN).
TRUST_PROXY=1
